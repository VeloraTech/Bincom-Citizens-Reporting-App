{
  "name": "bincom-citizens-reporting-app",
  "displayName": "WeSignal",
  "version": "1.0.0",
  "description": "A transparent mobile foundation for reporting and tracking community issues.",
  "main": "index.js",
  "scripts": {
    "prepare": "cordova prepare",
    "start": "cordova serve",
    "check": "node --check www/js/app.js && node --check www/js/supabase.js && node --check www/js/report-media.js",
    "build:android": "cordova build android --debug"
  },
  "keywords": [
    "cordova",
    "citizen-reporting",
    "community"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cordova-android": "^13.0.0",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^2.1.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-statusbar": "^3.0.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "cordova": "^12.0.0"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-device": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      }
    }
  }
}
