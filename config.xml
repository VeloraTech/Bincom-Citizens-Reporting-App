<?xml version='1.0' encoding='utf-8'?>
<widget id="com.bincom.citizensreporting" version="0.1.18" android-versionCode="10018" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>WeSignal</name>
  <description>See it. Report it. Improve it.</description>
  <author email="hello@bincom.com" href="https://github.com/VeloraTech/Bincom-Citizens-Reporting-App">Bincom</author>
  <content src="index.html" />
  <access origin="https://*.supabase.co" />
  <access origin="wss://*.supabase.co" />
  <access origin="https://cdn.jsdelivr.net" />
  <access origin="https://tile.openstreetmap.org" />
  <access origin="https://photon.komoot.io" />
  <access origin="https://fonts.googleapis.com" />
  <access origin="https://fonts.gstatic.com" />
  <allow-navigation href="https://*.supabase.co/*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="com.bincom.citizensreporting://*" />
  <preference name="AndroidXEnabled" value="true" />
  <preference name="GradlePluginGoogleServicesEnabled" value="false" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="StatusBarOverlaysWebView" value="false" />
  <preference name="StatusBarStyle" value="default" />
  <preference name="StatusBarBackgroundColor" value="#FFFFFF" />
  <preference name="AppendUserAgent" value="WeSignal/0.1.18 (+https://github.com/VeloraTech/Bincom-Citizens-Reporting-App)" />
  <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/icon-512.png" />
  <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
  <preference name="AndroidInsecureFileModeEnabled" value="false" />
  <icon src="resources/android/icon-512.png" />
  <platform name="android">
    <icon src="resources/android/icon/drawable-mdpi/icon.png" density="mdpi" foreground="resources/android/adaptive/mdpi/foreground.png" background="resources/android/adaptive/mdpi/background.png" />
    <icon src="resources/android/icon/drawable-hdpi/icon.png" density="hdpi" foreground="resources/android/adaptive/hdpi/foreground.png" background="resources/android/adaptive/hdpi/background.png" />
    <icon src="resources/android/icon/drawable-xhdpi/icon.png" density="xhdpi" foreground="resources/android/adaptive/xhdpi/foreground.png" background="resources/android/adaptive/xhdpi/background.png" />
    <icon src="resources/android/icon/drawable-xxhdpi/icon.png" density="xxhdpi" foreground="resources/android/adaptive/xxhdpi/foreground.png" background="resources/android/adaptive/xxhdpi/background.png" />
    <icon src="resources/android/icon/drawable-xxxhdpi/icon.png" density="xxxhdpi" foreground="resources/android/adaptive/xxxhdpi/foreground.png" background="resources/android/adaptive/xxxhdpi/background.png" />
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" android:usesCleartextTraffic="false" xmlns:android="http://schemas.android.com/apk/res/android" />
    <allow-intent href="market:*" />
  </platform>
</widget>
